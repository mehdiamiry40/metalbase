# Required durable capture and shared rate limiting (separate DB per environment)
DATABASE_URL=
# Required cron/health bearer secret: at least 32 random characters
CRON_SECRET=

# Email provider; production requires a verified sender
RESEND_API_KEY=
ENQUIRY_FROM=
# Optional recipient override; otherwise the verified server-only inbox is used
ENQUIRY_TO=

# Alternative HTTPS workflow provider (used only without RESEND_API_KEY)
ENQUIRY_WEBHOOK_URL=
# Optional signing contract agreed with the receiver; never blindly retry ambiguity
ENQUIRY_WEBHOOK_SECRET=
